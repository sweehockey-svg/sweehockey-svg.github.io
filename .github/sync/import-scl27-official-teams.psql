\set ON_ERROR_STOP on

begin;
set local statement_timeout = '10min';
set local lock_timeout = '30s';

create temporary table scl27_team_stage (
  sports_gamer_league_id bigint,
  sports_gamer_team_id bigint,
  team_name text,
  team_logo_url text,
  captain_player_id bigint,
  assistant_1_player_id bigint,
  assistant_2_player_id bigint,
  registered_at date
) on commit drop;

create temporary table scl27_roster_stage (
  sports_gamer_league_id bigint,
  sports_gamer_team_id bigint,
  sports_gamer_player_id bigint,
  display_gamertag text,
  player_country text,
  player_image text,
  player_number integer,
  preferred_position text,
  captain_role text
) on commit drop;

create temporary table scl_fcl_conflict_stage (
  sports_gamer_player_id bigint,
  display_gamertag text,
  scl_team_id bigint,
  scl_team_name text,
  fcl_team_id bigint,
  fcl_team_name text
) on commit drop;

\copy scl27_team_stage from '/tmp/scl27_official_teams.csv' with (format csv, header true, null '');
\copy scl27_roster_stage from '/tmp/scl27_official_roster.csv' with (format csv, header true, null '');
\copy scl_fcl_conflict_stage from '/tmp/scl_fcl_roster_conflicts.csv' with (format csv, header true, null '');

select 1 / case when count(*) >= 1 then 1 else 0 end as teams_must_exist
from scl27_team_stage;

select 1 / case
  when count(*) = count(distinct (sports_gamer_league_id,sports_gamer_team_id))
  then 1 else 0 end as teams_must_be_unique
from scl27_team_stage;

select 1 / case
  when count(*) = count(distinct (sports_gamer_league_id,sports_gamer_team_id,sports_gamer_player_id))
  then 1 else 0 end as roster_rows_must_be_unique
from scl27_roster_stage;

update public.sportsgamer_league_teams_current
set is_available=false,
    source_updated_at=now(),
    updated_at=now()
where sports_gamer_league_id=527;

insert into public.sportsgamer_league_teams_current (
  sports_gamer_league_id,
  sports_gamer_team_id,
  team_name,
  team_logo_url,
  captain_player_id,
  assistant_1_player_id,
  assistant_2_player_id,
  registered_at,
  is_available,
  source_updated_at,
  updated_at
)
select
  sports_gamer_league_id,
  sports_gamer_team_id,
  trim(team_name),
  nullif(trim(team_logo_url),''),
  captain_player_id,
  assistant_1_player_id,
  assistant_2_player_id,
  registered_at,
  true,
  now(),
  now()
from scl27_team_stage
where sports_gamer_league_id=527
on conflict (sports_gamer_league_id,sports_gamer_team_id)
do update set
  team_name=excluded.team_name,
  -- NULL is meaningful here: the current league entry has no logo.
  -- Do not preserve a stale logo from an older team identity.
  team_logo_url=excluded.team_logo_url,
  captain_player_id=excluded.captain_player_id,
  assistant_1_player_id=excluded.assistant_1_player_id,
  assistant_2_player_id=excluded.assistant_2_player_id,
  registered_at=coalesce(excluded.registered_at,public.sportsgamer_league_teams_current.registered_at),
  is_available=true,
  source_updated_at=now(),
  updated_at=now();

update public.sportsgamer_league_roster_current
set is_available=false,
    source_updated_at=now(),
    updated_at=now()
where sports_gamer_league_id=527;

insert into public.sportsgamer_league_roster_current (
  sports_gamer_league_id,
  sports_gamer_team_id,
  sports_gamer_player_id,
  display_gamertag,
  player_country,
  player_image,
  player_number,
  preferred_position,
  captain_role,
  is_available,
  source_updated_at,
  updated_at
)
select
  sports_gamer_league_id,
  sports_gamer_team_id,
  sports_gamer_player_id,
  trim(display_gamertag),
  nullif(upper(trim(player_country)),''),
  nullif(trim(player_image),''),
  player_number,
  nullif(upper(trim(preferred_position)),''),
  case when upper(coalesce(captain_role,'')) in ('C','A') then upper(captain_role) end,
  true,
  now(),
  now()
from scl27_roster_stage
where sports_gamer_league_id=527
on conflict (sports_gamer_league_id,sports_gamer_team_id,sports_gamer_player_id)
do update set
  display_gamertag=excluded.display_gamertag,
  player_country=excluded.player_country,
  player_image=excluded.player_image,
  player_number=excluded.player_number,
  preferred_position=excluded.preferred_position,
  captain_role=excluded.captain_role,
  is_available=true,
  source_updated_at=now(),
  updated_at=now();

delete from public.ehockey_scl_fcl_roster_conflicts;

insert into public.ehockey_scl_fcl_roster_conflicts (
  sports_gamer_player_id,
  display_gamertag,
  scl_team_id,
  scl_team_name,
  fcl_team_id,
  fcl_team_name,
  detected_at,
  updated_at
)
select
  sports_gamer_player_id,
  nullif(trim(display_gamertag),''),
  scl_team_id,
  nullif(trim(scl_team_name),''),
  fcl_team_id,
  nullif(trim(fcl_team_name),''),
  now(),
  now()
from scl_fcl_conflict_stage
where sports_gamer_player_id is not null
  and scl_team_id is not null
  and fcl_team_id is not null
on conflict (sports_gamer_player_id)
do update set
  display_gamertag=excluded.display_gamertag,
  scl_team_id=excluded.scl_team_id,
  scl_team_name=excluded.scl_team_name,
  fcl_team_id=excluded.fcl_team_id,
  fcl_team_name=excluded.fcl_team_name,
  detected_at=excluded.detected_at,
  updated_at=now();

select public.seh_sync_scl27_official_teams();

-- Laghistoriken läser materialiserade snapshots. Uppdatera dem i
-- beroendeordning så nyregistrerade SCL-lag blir synliga direkt.
refresh materialized view public.v_ehockey_team_tournaments;
refresh materialized view public.v_ehockey_team_tournaments_all;

select public.refresh_app_team_latest_leadership_cache();

commit;

select
  (select count(*)
   from public.sportsgamer_league_teams_current
   where sports_gamer_league_id=527 and is_available) as teams,
  (select count(*)
   from public.sportsgamer_league_roster_current
   where sports_gamer_league_id=527 and is_available) as roster_players,
  (select count(*)
   from public.ehockey_scl_fcl_roster_conflicts) as scl_fcl_conflicts;
