\set ON_ERROR_STOP on

begin;
set local statement_timeout='15min';
set local lock_timeout='30s';

create temporary table scl_recordbook_matches_stage (
  source_league_id bigint,
  source_match_id bigint,
  match_type text,
  played_at timestamptz,
  home_team_id bigint,
  away_team_id bigint,
  home_team_name text,
  away_team_name text,
  home_score integer,
  away_score integer
) on commit drop;

create temporary table scl_recordbook_goals_stage (
  source_league_id bigint,
  source_match_id bigint,
  source_team_id bigint,
  source_player_id bigint,
  goal_seconds integer
) on commit drop;

\copy scl_recordbook_matches_stage from '/tmp/recordbook_scl_matches.csv' with (format csv, header true, null '');
\copy scl_recordbook_goals_stage from '/tmp/recordbook_scl_goals.csv' with (format csv, header true, null '');

select 1 / case when count(*) >= 100 then 1 else 0 end as match_export_must_be_nontrivial
from scl_recordbook_matches_stage;

select 1 / case when count(*) >= 100 then 1 else 0 end as goal_export_must_be_nontrivial
from scl_recordbook_goals_stage;

select 1 / case
  when count(*) = count(distinct (source_league_id,source_match_id))
  then 1 else 0 end as matches_must_be_unique
from scl_recordbook_matches_stage;

select 1 / case
  when bool_and(source_league_id = any(array[47,83,148,233,310,369,447]::bigint[]))
  then 1 else 0 end as only_expected_scl_leagues
from scl_recordbook_matches_stage;

select public.seh_refresh_recordbook_scl_match_players_cache_v1() as refreshed_recordbook_players;

commit;

select count(*) as cached_recordbook_players
from public.seh_recordbook_scl_match_players_cache_v1;
