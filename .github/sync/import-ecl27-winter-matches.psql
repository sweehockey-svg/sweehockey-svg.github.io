\set ON_ERROR_STOP on
begin;
set local statement_timeout = '3min';
create temporary table winter_match_stage (
  match_id bigint primary key, league_id bigint, division text, stage text, group_name text,
  played_at timestamptz, home_id bigint, away_id bigint, home_team text, away_team text,
  home_score int, away_score int, overtime text
) on commit drop;
\copy winter_match_stage from '/tmp/ecl27_winter_matches.csv' with (format csv, header true, null '');

-- Same Swedish-club criterion as the season's team list. Do not publish unrelated matches.
with swedish as (
  select distinct snow.ext_id::bigint as id
  from public.v_local_team_list club
  cross join lateral unnest(club.sports_gamer_team_ids) as snow(ext_id)
  where club.effective_country = 'SE' and snow.ext_id::text ~ '^[0-9]+$'
)
insert into public.ehockey_season_matches_v1 (
  season_id,match_id,league_id,division,stage,group_name,played_at,
  home_team,away_team,home_score,away_score,overtime,swedish_team,updated_at
)
select 'ecl27winter',m.match_id,m.league_id,m.division,m.stage,m.group_name,m.played_at,
       m.home_team,m.away_team,m.home_score,m.away_score,m.overtime,
       case when h.id is not null then m.home_team else m.away_team end,now()
from winter_match_stage m
left join swedish h on h.id=m.home_id
left join swedish a on a.id=m.away_id
where (h.id is not null or a.id is not null) and m.league_id=:'winter_league_id'::bigint
on conflict (season_id,match_id) do update set
  league_id=excluded.league_id, division=excluded.division, stage=excluded.stage,
  group_name=excluded.group_name, played_at=excluded.played_at, home_team=excluded.home_team,
  away_team=excluded.away_team, home_score=excluded.home_score, away_score=excluded.away_score,
  overtime=excluded.overtime, swedish_team=excluded.swedish_team, updated_at=now();
commit;
