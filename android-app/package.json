{
  "name": "svensk-ehockey-android",
  "version": "0.1.0",
  "private": true,
  "description": "Android testapp för Svensk eHockey",
  "scripts": {
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:assets": "npx @capacitor/assets generate --android --iconBackgroundColor '#02030a' --iconBackgroundColorDark '#02030a' --splashBackgroundColor '#02030a' --splashBackgroundColorDark '#02030a'",
    "android:debug": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.0"
  }
}
